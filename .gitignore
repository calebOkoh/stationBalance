.claude/*

.DS_Store
__pycache__/
*.pyc

# Terraform: providers are re-downloadable, state is not committed, and the
# lock file is per-platform in this project (arm64 container + whatever the
# operator runs).
infra/**/.terraform/
infra/**/.terraform.lock.hcl
infra/states/*
*.tfplan

# Staged Lambda packages — regenerated by scripts/build_lambdas.sh
build/
deploy.env
