        <mxCell id="raw" value="&lt;b&gt;raw/&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;downloaded bytes, untouched&lt;br/&gt;59 objects · 109 MB&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#E8F4E4;strokeColor=#277116;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="545" y="140" width="200" height="54" as="geometry"/></mxCell>
        <mxCell id="par" value="&lt;b&gt;parsed/&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Parquet, schema normalised&lt;br/&gt;40 objects · 116 MB&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#E8F4E4;strokeColor=#277116;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="545" y="204" width="200" height="54" as="geometry"/></mxCell>
        <mxCell id="cln" value="&lt;b&gt;clean/&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;filtered, deduped, localised&lt;br/&gt;5,159 objects · 274 MB&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#E8F4E4;strokeColor=#277116;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="545" y="268" width="200" height="54" as="geometry"/></mxCell>
        <mxCell id="n2" value="Landing is separate from cleaning so a bad filter rule is fixed without re-downloading." style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="545" y="330" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="L4" value="EMR SERVERLESS — PySpark, phases 1-5, preInitializedCapacity = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6C74;dashed=1;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fontColor=#5A6C74;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="700" height="300" as="geometry"/></mxCell>
        <mxCell id="p1" value="&lt;b&gt;1 · Land&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;ZIP/CSV/JSON → Parquet&lt;br/&gt;no cleaning here&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FDEBDD;strokeColor=#D05C17;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="795" y="150" width="150" height="56" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;b&gt;2 · Conform&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;schema map, tz-localise&lt;br/&gt;filter, dedupe&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FDEBDD;strokeColor=#D05C17;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="960" y="150" width="150" height="56" as="geometry"/></mxCell>
        <mxCell id="p3" value="&lt;b&gt;3 · Labels&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;bike_id trajectories&lt;br/&gt;ledger → net_flow&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FDEBDD;strokeColor=#D05C17;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1125" y="150" width="150" height="56" as="geometry"/></mxCell>
        <mxCell id="p4" value="&lt;b&gt;4 · Features&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;weather join, calendar&lt;br/&gt;lags&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FDEBDD;strokeColor=#D05C17;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1290" y="150" width="150" height="56" as="geometry"/></mxCell>
        <mxCell id="p5" value="&lt;b&gt;5 · Assembly&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;wide table&lt;br/&gt;chronological split&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FDEBDD;strokeColor=#D05C17;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1125" y="250" width="150" height="56" as="geometry"/></mxCell>
        <mxCell id="g1" value="&lt;b&gt;GATE 2.2&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;timestamp parse rate&lt;br/&gt;hard-fails above 1%&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FDE8E8;strokeColor=#C7341C;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="960" y="228" width="150" height="46" as="geometry"/></mxCell>
        <mxCell id="g2" value="&lt;b&gt;GATE 3.2/3.3&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;synthetic recovery test&lt;br/&gt;on the cluster&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FDE8E8;strokeColor=#C7341C;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1125" y="320" width="150" height="46" as="geometry"/></mxCell>
        <mxCell id="g3" value="&lt;b&gt;GATE 4.8&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;leakage audit&lt;br/&gt;hard-fails the job&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FDE8E8;strokeColor=#C7341C;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1290" y="228" width="150" height="46" as="geometry"/></mxCell>
        <mxCell id="n3" value="Phase 3 must be a SINGLE GLOBAL PASS — partitioning by quarter injects a false rebalance every 3 months." style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#C7341C;" vertex="1" parent="1"><mxGeometry x="795" y="320" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="L5" value="SAGEMAKER — phase 6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6C74;dashed=1;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fontColor=#5A6C74;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1500" y="110" width="460" height="300" as="geometry"/></mxCell>
        <mxCell id="spl" value="&lt;b&gt;Training splits (S3)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;train 6,858,980 rows&lt;br/&gt;val 1,258,838 · test 1,308,180&lt;br/&gt;22 features · 86 MB&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#E8F4E4;strokeColor=#277116;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1515" y="140" width="190" height="68" as="geometry"/></mxCell>
        <mxCell id="trn" value="&lt;b&gt;SageMaker Processing&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;LightGBM · ml.t3.xlarge&lt;br/&gt;Training-job quota was 0,&lt;br/&gt;so Processing runs the same code&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#E0F5F1;strokeColor=#01A88D;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1725" y="140" width="215" height="68" as="geometry"/></mxCell>
        <mxCell id="reg" value="&lt;b&gt;Model Registry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;station-balance/1 Approved&lt;br/&gt;/2, /3 attribution instruments&lt;br/&gt;PendingManualApproval&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#E0F5F1;strokeColor=#01A88D;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1725" y="240" width="215" height="62" as="geometry"/></mxCell>
        <mxCell id="bun" value="&lt;b&gt;Model bundle&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;model_net_flow.txt&lt;br/&gt;features.json · metrics.json&lt;br/&gt;attribution.json&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#E8F4E4;strokeColor=#277116;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1515" y="240" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="n4" value="The bundle IS the deliverable. Attribution is the research output, not a by-product — a bundle missing attribution.json is refused at publish." style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="1515" y="318" width="425" height="58" as="geometry"/></mxCell>
        <mxCell id="L6" value="SUPPORTING — read-only convenience and guardrails, not dependencies" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6C74;dashed=1;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fontColor=#5A6C74;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1920" height="90" as="geometry"/></mxCell>
        <mxCell id="glu" value="&lt;b&gt;Glue Data Catalog&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;hand-written DDL, no crawler&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#EFE7FB;strokeColor=#4D27AA;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="458" width="200" height="48" as="geometry"/></mxCell>
        <mxCell id="ath" value="&lt;b&gt;Athena&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;QA gates · ledger diagnostics&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#EFE7FB;strokeColor=#4D27AA;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="280" y="458" width="200" height="48" as="geometry"/></mxCell>
        <mxCell id="cw" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;logs · monthly budget alarm&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#EFE7FB;strokeColor=#4D27AA;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="500" y="458" width="200" height="48" as="geometry"/></mxCell>
        <mxCell id="tf" value="&lt;b&gt;Terraform&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;3 layers: storage / ingestion / pipeline&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#EFE7FB;strokeColor=#4D27AA;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="720" y="458" width="200" height="48" as="geometry"/></mxCell>
        <mxCell id="cut" value="&lt;b&gt;EventBridge — NOT PROVISIONED&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;0 rules; preflight asserts zero&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#879196;dashed=1;" vertex="1" parent="1"><mxGeometry x="940" y="458" width="250" height="48" as="geometry"/></mxCell>
        <mxCell id="n5" value="Cost at rest is S3 storage only. EMR idles to zero in 15 min; no pre-initialised capacity, no NAT gateway, no MLflow server, no endpoint. Month-to-date spend: under $1." style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="1210" y="458" width="740" height="48" as="geometry"/></mxCell>
