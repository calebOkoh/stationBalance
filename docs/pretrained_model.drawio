        <mxCell id="cw" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;logs · budget alarm&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" vertex="1" parent="region"><mxGeometry x="610" y="380" width="78" height="78" as="geometry"/></mxCell>
        <mxCell id="n1" value="Phases run from numbered scripts, in order:
  2 conform   normalise schema, localise, filter, dedupe
  3 labels    bike_id trajectories → net_flow + occupancy
  4 features  weather join, calendar, lags
  5 assembly  wide table, chronological split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E0;strokeColor=#C08A2E;fontSize=10;fontColor=#40300F;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="region"><mxGeometry x="550" y="190" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="n2" value="No orchestrator. Every run is attended, so ordering comes from
scripts/ rather than Step Functions — you can stop halfway and inspect." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontSize=10;fontColor=#5A6C74;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="region"><mxGeometry x="30" y="540" width="560" height="50" as="geometry"/></mxCell>
        <mxCell id="n3" value="NOTHING IS ON A SCHEDULE.
No EventBridge rule exists in this account." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE6E6;strokeColor=#B04545;fontSize=10;fontColor=#3D1313;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="region"><mxGeometry x="620" y="540" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="n4" value="Tier-1 target: net_flow = arr − dep, counted from trip
