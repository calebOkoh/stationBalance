        <mxCell id="t2" value="The batch training pipeline. This is what is built and deployed. Every input is a historical archive downloaded once; nothing here polls, schedules, or reads live data." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#5A6C74;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1200" height="18" as="geometry"/></mxCell>
