        <mxCell id="t1" value="Indego Station Capacity — Batch Training Pipeline (BUILT)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1400" height="28" as="geometry"/></mxCell>
        <mxCell id="t2" value="Every input is a historical archive downloaded once. Nothing polls, schedules, or reads a live feed. Ordering comes from numbered scripts, not an orchestrator — every run is attended." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#5A6C74;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1600" height="16" as="geometry"/></mxCell>
        <mxCell id="t3" value="Figures are measured from the run of 2026-09-18, not estimated." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1600" height="16" as="geometry"/></mxCell>
        <mxCell id="L1" value="HISTORICAL SOURCES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6C74;dashed=1;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fontColor=#5A6C74;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="300" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Indego Trip Archives&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;18 quarterly ZIP · 103 MB&lt;br/&gt;2022-Q1 → 2026-Q2&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#F2F3F3;strokeColor=#879196;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="55" y="140" width="220" height="58" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Indego Station Table&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;1 CSV · 15 KB · 368 rows&lt;br/&gt;station_id, go-live, status&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#F2F3F3;strokeColor=#879196;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="55" y="208" width="220" height="58" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Open-Meteo Archive&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;40 JSON.gz · 1.8 MB&lt;br/&gt;4 grid points, not 354&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#F2F3F3;strokeColor=#879196;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="55" y="276" width="220" height="58" as="geometry"/></mxCell>
        <mxCell id="n1" value="4 grid points because the reanalysis grid is ~11 km — nearly every station shares a cell." style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="55" y="344" width="220" height="44" as="geometry"/></mxCell>
        <mxCell id="L2" value="INGEST" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6C74;dashed=1;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fontColor=#5A6C74;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="310" y="110" width="200" height="300" as="geometry"/></mxCell>
        <mxCell id="ing" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;station-balance-ingest&lt;br/&gt;3 tasks: trips | stations | weather&lt;br/&gt;no schedule, invoked by hand&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FDEBDD;strokeColor=#D05C17;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="325" y="190" width="170" height="70" as="geometry"/></mxCell>
