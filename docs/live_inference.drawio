<mxfile host="app.diagrams.net" type="device" agent="stationBalance/docs">
  <diagram id="live-inference" name="Live Inference">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1"
                  arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="520"
                  math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="u1" value="Indego Station Capacity — Live Inference (DESIGN ONLY, NOT BUILT)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1400" height="28" as="geometry"/></mxCell>
        <mxCell id="u2" value="Nothing in this diagram is deployed. It exists to show what a serving path would have to honour, and where it would attach to the pipeline that IS built." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#5A6C74;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1600" height="16" as="geometry"/></mxCell>
        <mxCell id="u3" value="The Model Registry is the ONLY link between the two diagrams. That is what makes the model portable." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#C7341C;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1600" height="16" as="geometry"/></mxCell>
        <mxCell id="reg2" value="&lt;b&gt;SageMaker Model Registry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;station-balance/1&lt;br/&gt;model + features.json + metrics&lt;br/&gt;THE HANDOFF — this is built&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#E0F5F1;strokeColor=#01A88D;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="230" height="74" as="geometry"/></mxCell>
        <mxCell id="u4" value="Everything to the right of this box is design. Everything to the left of it, in the other diagram, is deployed." style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="60" y="234" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="M1" value="LIVE SOURCES — read at inference time only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6C74;dashed=1;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fontColor=#5A6C74;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="250" height="250" as="geometry"/></mxCell>
        <mxCell id="l1" value="&lt;b&gt;GBFS station_status&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;live dock counts, ~250 stations&lt;br/&gt;supplies ONLY the integration&lt;br/&gt;constant O(s,t₀)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#F2F3F3;strokeColor=#879196;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="355" y="145" width="220" height="62" as="geometry"/></mxCell>
        <mxCell id="l2" value="&lt;b&gt;Open-Meteo Forecast&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;live endpoint, SAME 9 variables&lt;br/&gt;in the SAME order as training&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#F2F3F3;strokeColor=#879196;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="355" y="220" width="220" height="62" as="geometry"/></mxCell>
        <mxCell id="u5" value="A different variable list, or the same list in a different order, silently produces wrong predictions rather than an error." style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#C7341C;" vertex="1" parent="1"><mxGeometry x="355" y="292" width="220" height="56" as="geometry"/></mxCell>
        <mxCell id="M2" value="WOULD BE BUILT — none of this exists" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6C74;dashed=1;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fontColor=#5A6C74;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="800" height="250" as="geometry"/></mxCell>
        <mxCell id="eb" value="&lt;b&gt;EventBridge&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;hourly trigger&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#879196;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="150" height="56" as="geometry"/></mxCell>
        <mxCell id="fe" value="&lt;b&gt;Feature builder λ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;imports calendarfeat.py —&lt;br/&gt;the SAME file phase 4 uses&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#879196;dashed=1;" vertex="1" parent="1"><mxGeometry x="810" y="150" width="180" height="56" as="geometry"/></mxCell>
        <mxCell id="sc" value="&lt;b&gt;Scorer λ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;reads feature order FROM&lt;br/&gt;the model file&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#879196;dashed=1;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="180" height="56" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;API / cache&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;serves the prediction&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#879196;dashed=1;" vertex="1" parent="1"><mxGeometry x="1210" y="150" width="190" height="56" as="geometry"/></mxCell>
        <mxCell id="led" value="&lt;b&gt;Occupancy ledger&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;O(s,t₀) + Σ predicted net_flow&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#879196;dashed=1;" vertex="1" parent="1"><mxGeometry x="810" y="240" width="180" height="56" as="geometry"/></mxCell>
        <mxCell id="u6" value="calendarfeat.py is deliberately Spark-free so an inference path could import the exact same code rather than reimplement it. A reimplementation is where train/serve skew starts." style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="1010" y="232" width="390" height="70" as="geometry"/></mxCell>
        <mxCell id="M3" value="WHY IT IS NOT BUILT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6C74;dashed=1;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fontColor=#5A6C74;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1380" height="96" as="geometry"/></mxCell>
        <mxCell id="u7" value="The deliverable is a registered model and a measured attribution, not a service. Serving would add an always-on cost profile (endpoint or Lambda + API + cache) to a project whose cost at rest is S3 storage. Step 6.6 — validating reconstructed occupancy against recorded live dock counts — is also deferred: it needs a trip archive overlapping a window of polled station_status, and Indego publishes archives quarterly, so that overlap does not exist before the delivery date. Tier-2 occupancy therefore ships diagnostically consistent but WITHOUT a numeric error bar, and is reported that way." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="412" width="1340" height="64" as="geometry"/></mxCell>
        <mxCell id="f1" value="feature order + model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#5A6C74;strokeColor=#879196;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="reg2" target="sc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#5A6C74;strokeColor=#879196;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="eb" target="fe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#5A6C74;strokeColor=#879196;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="l2" target="fe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#5A6C74;strokeColor=#879196;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="fe" target="sc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#5A6C74;strokeColor=#879196;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="sc" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" value="O(s,t₀)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#5A6C74;strokeColor=#879196;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="l1" target="led"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f7" value="predicted net_flow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#5A6C74;strokeColor=#879196;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="sc" target="led"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#5A6C74;strokeColor=#879196;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="led" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
