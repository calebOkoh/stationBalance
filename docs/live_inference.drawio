<mxfile host="app.diagrams.net" type="device" agent="stationBalance/docs">
  <diagram id="live-inference" name="Live Inference Logic">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Indego Station Capacity — Live Inference Logic" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="t2" value="NOT DEPLOYED. An architecture deliverable showing what would exist if real-time inference were built, and how live data would interact with the pre-trained model." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#B04545;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1250" height="18" as="geometry"/></mxCell>
        <mxCell id="t3" value="The model itself is produced by docs/pretrained_model.drawio and is the only thing crossing from there into here. No live feed below ever becomes a training input." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#5A6C74;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1250" height="18" as="geometry"/></mxCell>
        <mxCell id="lx1" value="LIVE SOURCES — READ AT INFERENCE TIME ONLY" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="420" height="16" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;GBFS station_status&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;live dock counts · supplies O(s,t₀)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="210" height="52" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Open-Meteo Forecast&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;live · SAME variable list as training&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="210" height="52" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b&gt;Web Tool&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;out of scope · map + tendency graph&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="210" height="52" as="geometry"/></mxCell>
        <mxCell id="awscloud" value="AWS Cloud" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;container=1;collapsible=0;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=30;dashed=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="1400" height="700" as="geometry"/></mxCell>
        <mxCell id="region" value="Region — us-east-1" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;container=1;collapsible=0;fontColor=#147EBA;verticalAlign=top;align=left;spacingLeft=30;dashed=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#147EBA;" vertex="1" parent="awscloud"><mxGeometry x="40" y="60" width="1320" height="600" as="geometry"/></mxCell>
        <mxCell id="band0" value="HANDOFF — the only link to the training pipeline" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#879196;fontSize=11;fontStyle=2;fontColor=#879196;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="region"><mxGeometry x="30" y="40" width="250" height="180" as="geometry"/></mxCell>
        <mxCell id="band1" value="SCHEDULE" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#879196;fontSize=11;fontStyle=2;fontColor=#879196;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="region"><mxGeometry x="300" y="40" width="200" height="180" as="geometry"/></mxCell>
        <mxCell id="band2" value="PREDICT" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#879196;fontSize=11;fontStyle=2;fontColor=#879196;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="region"><mxGeometry x="520" y="40" width="240" height="180" as="geometry"/></mxCell>
        <mxCell id="band3" value="SERVE — model is NOT on the request path" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#879196;fontSize=11;fontStyle=2;fontColor=#879196;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="region"><mxGeometry x="780" y="40" width="500" height="180" as="geometry"/></mxCell>
        <mxCell id="reg" value="&lt;b&gt;SageMaker Model Registry&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;model + features.json + transformers&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4AB29A;gradientDirection=north;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sagemaker;" vertex="1" parent="region"><mxGeometry x="90" y="100" width="78" height="78" as="geometry"/></mxCell>
        <mxCell id="eb" value="&lt;b&gt;EventBridge&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;hourly · 60 s&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#FF4F8B;gradientDirection=north;fillColor=#B0084D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="region"><mxGeometry x="340" y="100" width="78" height="78" as="geometry"/></mxCell>
        <mxCell id="inf" value="&lt;b&gt;Lambda — inference&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;predict net_flow → integrate → P(empty)&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="region"><mxGeometry x="580" y="100" width="78" height="78" as="geometry"/></mxCell>
        <mxCell id="stat" value="&lt;b&gt;Lambda — status refresh&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;keeps map dots live&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="region"><mxGeometry x="580" y="300" width="78" height="78" as="geometry"/></mxCell>
        <mxCell id="ddb" value="&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;precomputed cube · ~12 K rows&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#527FFF;gradientDirection=north;fillColor=#2E27AD;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="region"><mxGeometry x="840" y="100" width="78" height="78" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;HTTP API · /stations /forecast /attribution&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#A166FF;gradientDirection=north;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="region"><mxGeometry x="1040" y="100" width="78" height="78" as="geometry"/></mxCell>
        <mxCell id="cf" value="&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;global edge · 60 s TTL&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#A166FF;gradientDirection=north;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="region"><mxGeometry x="1200" y="100" width="78" height="78" as="geometry"/></mxCell>
        <mxCell id="cw" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;logs · metrics&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#FF4F8B;gradientDirection=north;fillColor=#B0084D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" vertex="1" parent="region"><mxGeometry x="340" y="300" width="78" height="78" as="geometry"/></mxCell>
        <mxCell id="n1" value="Why a precomputed cube and not live scoring:
~354 stations × 48 hours ≈ 12 K rows. Enumerating beats serving live at that
size, and a failed refresh degrades to stale data rather than a 5xx." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3EA;strokeColor=#4A8A5F;fontSize=10;fontColor=#173322;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="region"><mxGeometry x="780" y="260" width="500" height="60" as="geometry"/></mxCell>
        <mxCell id="n2" value="The contract the training pipeline fixes:
  · identical feature list and order, from features.json
  · calendar features from SHARED code, not a reimplementation
  · live station_status supplies only the integration constant O(s,t₀)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E0;strokeColor=#C08A2E;fontSize=10;fontColor=#40300F;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="region"><mxGeometry x="30" y="400" width="700" height="75" as="geometry"/></mxCell>
        <mxCell id="n3" value="None of this exists in the account. No DynamoDB table, no API Gateway,
no CloudFront distribution, no Lambda. This diagram is the deliverable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE6E6;strokeColor=#B04545;fontSize=10;fontColor=#3D1313;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="region"><mxGeometry x="780" y="400" width="500" height="50" as="geometry"/></mxCell>
        <mxCell id="e1" value="artifact bundle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#879196;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="reg" target="inf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#879196;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="eb" target="inf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#879196;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="eb" target="stat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="O(s,t₀)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#879196;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="s1" target="inf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#879196;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="s2" target="inf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#879196;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="s1" target="stat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="12 K predictions / refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;" edge="1" parent="1" source="inf" target="ddb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="every 60 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;" edge="1" parent="1" source="stat" target="ddb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="1 read · &lt;10 ms" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;" edge="1" parent="1" source="ddb" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;" edge="1" parent="1" source="api" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="60 s edge TTL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;" edge="1" parent="1" source="cf" target="web"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
